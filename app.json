{
  "expo": {
    "name": "Shef V2",
    "slug": "shef-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shefv2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shef.v2",
      "infoPlist": {
        "NSCameraUsageDescription": "Shef V2 uses the camera to photograph your fridge so you can note ingredients for your pantry.",
        "NSPhotoLibraryUsageDescription": "Shef V2 needs access to your photos so you can upload a picture of your fridge."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shef V2 to access your photos to upload a fridge picture.",
          "cameraPermission": "Allow Shef V2 to use the camera to photograph your fridge."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
